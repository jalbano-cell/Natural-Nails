---
import { business } from "../data/business";
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="brand" href="#top">
          <span class="mark">9</span>
          <span><b>Natural Nails &amp; Spa</b><span>{business.city}, {business.region}</span></span>
        </a>
        <p>A neighbourhood nail salon on Rathburn Road, known for careful work, kind staff, and prices that stay fair.</p>
      </div>
      <div class="foot-col">
        <h5>Explore</h5>
        <a href="#services">Services &amp; Pricing</a>
        <a href="#russian">Russian Manicure</a>
        <a href="#gallery">Lookbook</a>
        <a href="#reviews">Reviews</a>
        <a href="#visit">Visit Us</a>
      </div>
      <div class="foot-col">
        <h5>Get in touch</h5>
        <a href={business.phone.href}>{business.phone.display}</a>
        <a href={business.instagram.url} target="_blank" rel="noopener">Instagram · {business.instagram.handle}</a>
        <a href={`https://www.google.com/maps?q=${business.address.mapQuery}`} target="_blank" rel="noopener">{business.address.line1}</a>
        <a href="#visit">{business.address.line2}</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span class="mono">© {year} {business.name}</span>
      <span class="mono">Website preview — OmniGrid Digital</span>
    </div>
  </div>
</footer>
