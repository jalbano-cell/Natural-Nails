---
import { business, getBookingHref, isSetmoreActive } from "../data/business";

interface Props {
  class?: string;
  phoneLabel?: string;
  setmoreLabel?: string;
  showIcon?: boolean;
}

const {
  class: className = "btn btn-primary",
  phoneLabel = business.phone.display,
  setmoreLabel = "Book online",
  showIcon = false,
} = Astro.props;

const setmore = isSetmoreActive();
const href = getBookingHref();
const label = setmore ? setmoreLabel : phoneLabel;
---

<a class={className} href={href} target={setmore ? "_blank" : undefined} rel={setmore ? "noopener" : undefined}>
  {showIcon && (setmore ? (
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M9 16l2 2 4-4"></path></svg>
  ) : (
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
  ))}
  {label}
</a>
