---
import { business } from "../data/business";
import BookButton from "./BookButton.astro";
---

<section class="block" id="visit">
  <div class="wrap">
    <div class="visit-grid reveal">
      <div class="visit-info">
        <span class="eyebrow">Come see us</span>
        <h2>Find us on Rathburn Road</h2>
        <div class="info-row">
          <span class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
          <div><b>Address</b><span>{business.address.line1}<br>{business.address.line2}</span></div>
        </div>
        <div class="info-row">
          <span class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg></span>
          <div><b>Phone</b><span><a href={business.phone.href}>{business.phone.display}</a></span></div>
        </div>
        <div class="info-row">
          <span class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>
          <div style="flex:1"><b>Hours</b>
            <div class="hours">
              {business.hours.map((h) => (
                <div><span>{h.day}</span><b>{h.time}</b></div>
              ))}
            </div>
          </div>
        </div>
        <BookButton phoneLabel="Call to book your visit" setmoreLabel="Book your visit online" />
      </div>
      <iframe class="map" title={`Map to ${business.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"
        src={`https://www.google.com/maps?q=${business.address.mapQuery}&output=embed`}></iframe>
    </div>
  </div>
</section>
