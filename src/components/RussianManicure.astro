---
import BookButton from "./BookButton.astro";
---

<section class="block" id="russian" style="padding-top:20px">
  <div class="wrap">
    <div class="feature reveal">
      <div class="feature-body">
        <span class="eyebrow">Why people travel for it</span>
        <h2>The Russian manicure, done right.</h2>
        <p>It's a <em>dry</em> manicure — no soaking. An e-file gently lifts the cuticle so colour can be laid right up to the skin. The result is a cleaner edge and wear that stretches past three weeks.</p>
        <ul>
          <li>Ultra-clean cuticle line with zero flooding</li>
          <li>Colour applied closer to the base — grows out gracefully</li>
          <li>Longer-lasting than a standard gel manicure</li>
          <li>Loved by clients who want their nails to look freshly done for weeks</li>
        </ul>
        <BookButton phoneLabel="Book a Russian manicure" setmoreLabel="Book a Russian manicure" />
      </div>
      <div class="feature-art">
        <svg class="hand" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <g stroke="rgba(246,240,232,.9)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M70 175 C58 150 56 120 60 96 C61 88 70 88 71 96 L74 120" fill="rgba(232,215,197,.16)"></path>
            <path d="M74 118 C72 96 72 70 74 58 C75 50 84 50 85 58 L86 116"></path>
            <path d="M86 116 C85 92 86 62 88 50 C89 42 98 42 99 50 L100 114"></path>
            <path d="M100 114 C99 94 100 66 102 56 C103 48 112 48 113 56 L114 116"></path>
            <path d="M114 118 C114 100 116 82 119 74 C121 68 129 70 128 78 L124 118"></path>
            <path d="M60 96 C56 108 58 150 70 175 L124 175 C132 150 130 130 124 118 C118 128 100 128 100 114"></path>
          </g>
          <g fill="var(--berry)">
            <ellipse cx="78" cy="55" rx="6" ry="8"></ellipse>
            <ellipse cx="92" cy="47" rx="6" ry="8"></ellipse>
            <ellipse cx="106" cy="53" rx="6" ry="8"></ellipse>
            <ellipse cx="121" cy="72" rx="5.5" ry="7"></ellipse>
            <ellipse cx="65" cy="93" rx="5.5" ry="7"></ellipse>
          </g>
        </svg>
        <div class="price-badge"><b>$55</b><small>Russian mani</small></div>
      </div>
    </div>
  </div>
</section>
