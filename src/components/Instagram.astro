---
import { business } from "../data/business";
---

<section class="block ig" id="instagram">
  <div class="wrap">
    <div class="ig-head reveal">
      <div class="ig-id">
        <div class="ig-ring"><span class="mark">9</span></div>
        <div>
          <h3>{business.instagram.displayName}</h3>
          <a class="handle" href={business.instagram.url} target="_blank" rel="noopener">{business.instagram.handle}</a>
          <div class="bio">{business.instagram.bio}</div>
        </div>
      </div>
      <div class="ig-stats">
        <div><b>{business.instagram.posts}</b><small>Posts</small></div>
        <div><b>{business.instagram.followers}</b><small>Followers</small></div>
        <div><b>{business.rating.score}★</b><small>Rated</small></div>
      </div>
    </div>

    <div class="ig-feed">
      {business.instagram.tileClasses.map((cls) => (
        <a class={`ig-tile ${cls} reveal`} href={business.instagram.url} target="_blank" rel="noopener" aria-label="View on Instagram">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
        </a>
      ))}
    </div>

    <div class="ig-cta reveal">
      <a class="btn btn-ig" href={business.instagram.url} target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
        Follow {business.instagram.handle}
      </a>
    </div>
    <p class="ig-note">Preview tiles — connect the live Instagram feed to show real posts here.</p>
  </div>
</section>
